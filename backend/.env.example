# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=villas_boats
DB_USER=villasboats
DB_PASSWORD=change_this_password_in_production

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_password_in_production

# JWT Configuration
JWT_SECRET_KEY=change-this-in-production-must-be-at-least-256-bits-long-for-hs256-algorithm

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://villasboats.com,https://www.villasboats.com

# Storage Configuration (S3/MinIO)
STORAGE_TYPE=s3
S3_BUCKET=villas-boats
S3_REGION=us-east-1
S3_ACCESS_KEY=your_access_key_here
S3_SECRET_KEY=your_secret_key_here

# Application Version
VERSION=1.0.0
