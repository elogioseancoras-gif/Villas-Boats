 <span class=\"label\">Total Price:</span> {{ $json.total_price }} {{ $json.currency }}\n      </div>\n      {{ $json.customer_notes ? '<div class=\"detail\"><span class=\"label\">Customer Notes:</span> ' + $json.customer_notes + '</div>' : '' }}\n      \n      <p style=\"margin-top: 30px; padding: 15px; background: #e8f4f8; border-radius: 5px;\">\n        <strong>Next Steps:</strong><br>\n        1. Review boat availability for requested dates<br>\n        2. Contact customer within 24 hours<br>\n        3. Confirm or propose alternative dates\n      </p>\n    </div>\n  </div>\n</body>\n</html>",
        "options": {}
