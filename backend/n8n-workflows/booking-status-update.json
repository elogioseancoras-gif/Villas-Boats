    {
      "parameters": {
        "fromEmail": "noreply@villasboats.com",
        "toEmail": "={{ $json.customer_email }}",
        "subject": "✅ Booking Confirmed - {{ $json.booking_reference }}",
        "emailType": "html",
        "message": "<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }\n    .container { max-width: 600px; margin: 0 auto; padding: 20px; }\n    .header { background: linear-gradient(135deg, #28a745 0%, #20c997 100%); color: white; padding: 30px; text-align: center; border-radius: 10px 10px 0 0; }\n    .content { background: #f9f9f9; padding: 30px; border-radius: 0 0 10px 10px; }\n    .detail { margin: 10px 0; padding: 10px; background: white; border-radius: 5px; }\n    .label { font-weight: bold; color: #28a745; }\n    .important { background: #d4edda; border-left: 4px solid #28a745; padding: 15px; margin: 20px 0; }\n    .footer { text-align: center; margin-top: 30px; padding: 20px; color: #666; font-size: 0.9em; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h1>✅ Your Booking is Confirmed!</h1>\n      <p>Reference: {{ $json.booking_reference }}</p>\n    </div>\n    <div class=\"content\">\n      <p>Dear {{ $json.customer_name }},</p>\n      <p>Great news! Your boat booking has been confirmed. We're excited to have you aboard!</p>\n      \n      <h3>📋 Confirmed Booking Details:</h3>\n      <div class=\"detail\">\n        <span class=\"label\">Boat:</span> {{ $json.boat_name }}\n      </div>\n      <div class=\"detail\">\n        <span class=\"label\">Dates:</span> {{ $json.start_datetime }} to {{ $json.end_datetime }}\n      </div>\n      <div class=\"detail\">\n        <span class=\"label\">Guests:</span> {{ $json.guest_count }} people\n      </div>\n      <div class=\"detail\">\n        <span class=\"label\">Captain:</span> {{ $json.needs_captain ? 'Included ⚓' : 'Not included' }}\n      </div>\n      <div class=\"detail\">\n        <span class=\"label\">Total Price:</span> {{ $json.total_price }} {{ $json.currency }}\n      </div>\n      \n      <div class=\"important\">\n        <strong>📍 What's Next?</strong><br>\n        • Check-in location and time will be sent 48 hours before your trip<br>\n        • Please arrive 15 minutes early for safety briefing<br>\n        • Bring valid ID and confirmation email<br>\n        • Contact us at {{ $json.whatsapp_number }} for any questions\n      </div>\n      \n      <p>We look forward to providing you with an unforgettable experience!</p>\n      \n      <div class=\"footer\">\n        <p><strong>Villas Boats Team</strong></p>\n        <p style=\"font-size: 0.85em; color: #999;\">For support, contact us at {{ $json.whatsapp_number }}</p>\n      </div>\n    </div>\n  </div>\n</body>\n</html>",
        "options": {}
      },
