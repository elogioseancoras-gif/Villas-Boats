        "emailType": "html",
        "message": "<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }\n    .container { max-width: 600px; margin: 0 auto; padding: 20px; }\n    .header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 30px; text-align: center; border-radius: 10px 10px 0 0; }\n    .content { background: #f9f9f9; padding: 30px; border-radius: 0 0 10px 10px; }\n    .detail { margin: 10px 0; padding: 10px; background: white; border-radius: 5px; }\n    .label { font-weight: bold; color: #667eea; }\n    .review { background: #e8f4f8; border-left: 4px solid #17a2b8; padding: 15px; margin: 20px 0; text-align: center; }\n    .footer { text-align: center; margin-top: 30px; padding: 20px; color: #666; font-size: 0.9em; }\n    .button { display: inline-block; padding: 12px 30px; background: #667eea; color: white; text-decoration: none; border-radius: 5px; margin: 10px 0; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h1>🎉 Thank You for Sailing with Us!</h1>\n      <p>Reference: {{ $json.booking_reference }}</p>\n    </div>\n    <div class=\"content\">\n      <p>Dear {{ $json.customer_name }},</p>\n      <p>We hope you had an amazing time on your boat adventure! Your booking has been marked as completed.</p>\n      \n      <h3>📋 Trip Summary:</h3>\n      <div class=\"detail\">\n        <span class=\"label\">Boat:</span> {{ $json.boat_name }}\n      </div>\n      <div class=\"detail\">\n        <span class=\"label\">Dates:</span> {{ $json.start_datetime }} to {{ $json.end_datetime }}\n      </div>\n      <div class=\"detail\">\n        <span class=\"label\">Guests:</span> {{ $json.guest_count }} people\n      </div>\n      \n      <div class=\"review\">\n        <h3>⭐ Share Your Experience!</h3>\n        <p>We'd love to hear about your trip! Your feedback helps us improve and helps others choose their perfect boat experience.</p>\n        <a href=\"https://villasboats.com/reviews/new?booking={{ $json.booking_reference }}\" class=\"button\">Leave a Review</a>\n      </div>\n      \n      <p>We'd be thrilled to have you back for another adventure! As a returning customer, you'll receive a special discount on your next booking.</p>\n      \n      <div class=\"footer\">\n        <p><strong>Villas Boats Team</strong></p>\n        <p style=\"font-size: 0.85em; color: #999;\">Contact us anytime at {{ $json.whatsapp_number }}</p>\n      </div>\n    </div>\n  </div>\n</body>\n</html>",
        "options": {}
      },
