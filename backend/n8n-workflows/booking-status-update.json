        "emailType": "html",
        "message": "<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }\n    .container { max-width: 600px; margin: 0 auto; padding: 20px; }\n    .header { background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); color: white; padding: 30px; text-align: center; border-radius: 10px 10px 0 0; }\n    .content { background: #f9f9f9; padding: 30px; border-radius: 0 0 10px 10px; }\n    .detail { margin: 10px 0; padding: 10px; background: white; border-radius: 5px; }\n    .label { font-weight: bold; color: #dc3545; }\n    .info { background: #f8d7da; border-left: 4px solid #dc3545; padding: 15px; margin: 20px 0; }\n    .footer { text-align: center; margin-top: 30px; padding: 20px; color: #666; font-size: 0.9em; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h1>❌ Booking Cancelled</h1>\n      <p>Reference: {{ $json.booking_reference }}</p>\n    </div>\n    <div class=\"content\">\n      <p>Dear {{ $json.customer_name }},</p>\n      <p>Your booking has been cancelled as requested.</p>\n      \n      <h3>📋 Cancelled Booking Details:</h3>\n      <div class=\"detail\">\n        <span class=\"label\">Boat:</span> {{ $json.boat_name }}\n      </div>\n      <div class=\"detail\">\n        <span class=\"label\">Original Dates:</span> {{ $json.start_datetime }} to {{ $json.end_datetime }}\n      </div>\n      {{ $json.cancellation_reason ? '<div class=\"detail\"><span class=\"label\">Reason:</span> ' + $json.cancellation_reason + '</div>' : '' }}\n      \n      <div class=\"info\">\n        <strong>💰 Refund Information:</strong><br>\n        If you paid a deposit or full payment, our team will process your refund according to our cancellation policy. You'll receive a separate email with refund details within 3-5 business days.\n      </div>\n      \n      <p>We're sorry to see this booking cancelled. If you'd like to book for different dates or have any questions, please don't hesitate to contact us!</p>\n      \n      <div class=\"footer\">\n        <p><strong>Villas Boats Team</strong></p>\n        <p style=\"font-size: 0.85em; color: #999;\">Contact us at {{ $json.whatsapp_number }}</p>\n      </div>\n    </div>\n  </div>\n</body>\n</html>",
        "options": {}
